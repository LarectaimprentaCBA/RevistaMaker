{
  "name": "revistamaker",
  "version": "0.2.0",
  "description": "Imposicion saddle-stitch para revistas abrochadas a caballo - La Recta Imprenta",
  "type": "module",
  "author": {
    "name": "La Recta Imprenta",
    "email": "mariano_s_9@hotmail.com"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5174 && electron .",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "build": "vite build",
    "preview": "vite preview",
    "icon": "powershell -ExecutionPolicy Bypass -File build/make-icon.ps1 && node scripts/make-ico.mjs",
    "pack": "npm run build && electron-builder --dir",
    "installer": "npm run build && electron-builder --win nsis",
    "release": "npm run build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "electron-updater": "^6.8.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.379",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "vite": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.larectaimprenta.revistamaker",
    "productName": "RevistaMaker",
    "copyright": "Copyright (c) 2026 La Recta Imprenta",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "node_modules/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false,
      "signtoolOptions": {
        "publisherName": "La Recta Imprenta",
        "certificateFile": "build/codesign.pfx",
        "certificatePassword": "PrintLayoutLR2026",
        "signingHashAlgorithms": ["sha256"]
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RevistaMaker"
    },
    "publish": {
      "provider": "github",
      "owner": "LarectaimprentaCBA",
      "repo": "RevistaMaker"
    }
  }
}
